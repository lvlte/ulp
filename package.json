{
  "name": "@lvlte/ulp",
  "version": "1.5.0",
  "description": "Compute the ULP of a given number / Get the closest representable number that comes before/after it on the float64 number line",
  "license": "MIT",
  "author": "Eric Lavault <lvlte.code@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlte/ulp.git"
  },
  "bugs": {
    "url": "https://github.com/lvlte/ulp/issues"
  },
  "type": "module",
  "main": "./dist/cjs/index.js",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "unpkg": "./dist/umd/ulp.min.js",
  "jsdelivr": "./dist/umd/ulp.js",
  "engines": {
    "node": ">=18.20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "tscheck": "tsc --noEmit && tsc -p ./test/tsconfig.json",
    "pretest": "npm run tscheck",
    "test": "jest --verbose",
    "prebuild": "rm -Rf dist && mkdir dist",
    "build": "tsdown",
    "postbuild": "(echo { \"type\": \"commonjs\" }) > ./dist/cjs/package.json",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "number",
    "epsilon",
    "precision",
    "eps",
    "ulp",
    "nextFloat",
    "prevFloat",
    "next",
    "previous",
    "float",
    "float64",
    "IEEE-754",
    "rounding",
    "tolerance",
    "ULP"
  ],
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@lvlte/tsconfig": "^1.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "unrs-resolver": true
  },
  "overrides": {
    "test-exclude": {
      "glob": "^13.0.6"
    }
  }
}
